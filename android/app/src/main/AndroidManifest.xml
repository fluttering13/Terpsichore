        </activity-alias>

        <!-- One-release migration tombstones for timestamped aliases produced
             by older debug builds. Keep the names disabled so launchers can
             reconcile stale pinned entries after an app update. -->
        <activity-alias android:name=".FlutterDebugLauncher1789585372687" android:enabled="false" android:exported="true" android:icon="@mipmap/ic_launcher" android:label="Terpsichore" android:targetActivity=".MainActivity">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".FlutterDebugLauncher1789585493646" android:enabled="false" android:exported="true" android:icon="@mipmap/ic_launcher" android:label="Terpsichore" android:targetActivity=".MainActivity">
