        <activity-alias android:name=".DelightfulIcon" android:enabled="false" android:exported="true" android:icon="@mipmap/emotion_delightful" android:label="Terpsichore" android:targetActivity=".MainActivity">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
