        </activity-alias>
        <activity-alias android:name=".Lay2Icon" android:enabled="false" android:exported="true" android:icon="@mipmap/emotion_lay2" android:label="Terpsichore" android:targetActivity=".MainActivity">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
